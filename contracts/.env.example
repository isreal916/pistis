# Deployer key — only pays gas to deploy PistisFactory once per network.
# Individual escrows are created afterwards via factory.createEscrow(...),
# no further deploy script runs needed.
PRIVATE_KEY=

# LayerZero OFT Adapter for FXRP on the target network.
# Verified live against https://dev.flare.network/fxrp/oft on 2026-08-09 — this is
# the Coston2 adapter specifically. Re-verify before deploying if that date is old,
# or if targeting a different network.
OFT_ADAPTER_ADDRESS=0xCd3d2127935Ae82Af54Fc31cCD9D3440dbF46639

# Optional — only needed if you run `forge verify-contract` separately
COSTON2_EXPLORER_API_KEY=
